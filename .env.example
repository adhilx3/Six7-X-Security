# Discord Bot Gateway Token
DISCORD_TOKEN=your_bot_token_here

# Web Dashboard Port (automatically assigned by Railway)
PORT=8080

# Web Dashboard Authentication
DASHBOARD_PASSWORD=your_secure_master_password_here
SESSION_SECRET=your_random_secret_hex_key_here

# Optional: Discord OAuth2 Login for Server Admins
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-railway-app.up.railway.app/auth/discord/callback
